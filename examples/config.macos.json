{
  "provider": "bridge-local",
  "model": "<model-name>",
  "baseUrl": "http://<INFERENCE_HOST>:<PORT>/v1",
  "api": "openai-completions",
  "modelOptions": {
    "name": "Remote model",
    "reasoning": true,
    "contextWindow": 262144,
    "maxTokens": 8192,
    "compat": {
      "supportsDeveloperRole": false,
      "supportsReasoningEffort": false,
      "thinkingFormat": "qwen-chat-template"
    }
  },
  "sandbox": {
    "mode": "seatbelt"
  }
}
